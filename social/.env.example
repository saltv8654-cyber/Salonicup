# --- Phase 1 (απαραίτητα) — τα Supabase/Anthropic είναι τα ΙΔΙΑ με του Salonicup app ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx          # ΜΟΝΟ server
ANTHROPIC_API_KEY=sk-ant-xxx                     # ΜΟΝΟ server
CRON_SECRET=                                     # τυχαίο string, για /api/worker/tick
TOKEN_ENCRYPTION_KEY=                            # openssl rand -base64 32


# Προαιρετικά
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high                                # low | medium | high | xhigh | max

# --- Phase 3 (social) ---
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
